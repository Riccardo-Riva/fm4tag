# S2 (part 4) — P2's recipe grid again, WITH gradient clipping (1.0, from
# arm/pretrain.yaml), added 2026-10-20. Without clipping every P2 point spiked
# at the lr peak: at T=0.1 the track embeddings collapsed (recovered partly once
# the lr had decayed), at T=0.3 the whole jet embedding collapsed (loss = ln 511,
# rank ~1) and those two runs were stopped. Cells are named p2c_* so the
# unclipped p2_* runs stay a separate, comparable set.
#
# Same settings as the P2 cells of S2_pretrain.cells; each probe (same as
# S2_probe.cells) waits for its own pretraining in the queue.
# Epoch (39.7M jets, A40): ~4700 s (S2 P2, unclipped); probe ~600 s.
#
#   ENCODERS=rowcol_concat_v0 CHUNK=512 B_PRE=12288 SEEDS=42 PACKS=2 \
#   MAX_EPOCHS=10 EST_SECONDS_PER_EPOCH=5000 WALLTIME=2-00:00:00 \
#   CELLS=experiments/2026-10_ssl-campaign/configs/S2_p2clip.cells bash slurm/ssl_pack.sh
p2c_T0.1_lam0.1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1 lambda=0.1
p2c_T0.1_lam0.4  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1 lambda=0.4
p2c_T0.3_lam0.1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.3 lambda=0.1
p2c_T0.3_lam0.4  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.3 lambda=0.4
fr_p2c_T0.1_lam0.1  arm=frozen encoder_ckpt=@p2c_T0.1_lam0.1 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
fr_p2c_T0.1_lam0.4  arm=frozen encoder_ckpt=@p2c_T0.1_lam0.4 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
fr_p2c_T0.3_lam0.1  arm=frozen encoder_ckpt=@p2c_T0.3_lam0.1 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
fr_p2c_T0.3_lam0.4  arm=frozen encoder_ckpt=@p2c_T0.3_lam0.4 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
