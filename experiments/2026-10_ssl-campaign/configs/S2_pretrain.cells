# S2 (part 1) — pretraining recipe at temperature T x augmentation strength
# lambda, 10 epochs, 1 seed, for
#   P0: contrastive on the feature embeddings (tracks, global jet features);
#       its winner is reused for P1 (= P0 + jet-level contrastive);
#   P2: contrastive on the global jet embedding (aggregator output) only.
# Each is judged by its frozen-encoder probe (S2_probe.cells), NOT by the
# pretraining loss, whose scale changes with T and lambda. P2 uses P0's batch
# (it needs less memory: no track-level contrastive matrices), so the two
# pretrainings share the optimisation settings.
#
# Row mode and chunk size = the S1 winner. Batch for ~38 GiB peak (S0; the
# chunked contrastive loss grows with C):
#              per_token   concat
#   C = 128      22528      18432
#   C = 512      16384      12288
# Epoch (39.7M jets, A40): ~7000 s per_token, ~4500 s concat.
#
#   ENCODERS=rowcol_v0 CHUNK=128 B_PRE=22528 SEEDS=42 MAX_EPOCHS=10 \
#   EST_SECONDS_PER_EPOCH=7500 GPU_NODE=gpu-A40,gpu-L40S-open MEM=48G \
#   CELLS=experiments/2026-10_ssl-campaign/configs/S2_pretrain.cells bash experiments/2026-10_ssl-campaign/slurm/ssl_campaign.sh
p0_T0.1_lam0.1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.contrastive_loss.temperature=0.1 lambda=0.1
p0_T0.1_lam0.4  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.contrastive_loss.temperature=0.1 lambda=0.4
p0_T0.3_lam0.1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.contrastive_loss.temperature=0.3 lambda=0.1
p0_T0.3_lam0.4  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.contrastive_loss.temperature=0.3 lambda=0.4
p2_T0.1_lam0.1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1 lambda=0.1
p2_T0.1_lam0.4  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1 lambda=0.4
p2_T0.3_lam0.1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.3 lambda=0.1
p2_T0.3_lam0.4  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.3 lambda=0.4
