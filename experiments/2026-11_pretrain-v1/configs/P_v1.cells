# P0 and P1 pretrained again with the protocol-v1 settings (rriva, 2026-11-23): batch 12800, WSD over 80 epochs
# (warmup 4 epochs = 5 %, constant, linear decay over the last 20 % = epochs 64-80), no early stopping, last checkpoint
# loaded downstream; otherwise the P_full recipe: lr 1e-3, gradient clip 1.0, contrastive T 0.1, lambda 0.4, no dropout.
#   p0_v1 = per-object contrastive on the track and jet-feature embeddings
#   p1_v1 = p0 + jet contrastive (weight 1.0, T 0.1) on the aggregator output (aggregator trained, loaded downstream)
# Seeds: see the launch command (the downstream then uses the seed with the lowest pretraining val loss).
# One pretraining per card: at batch 12800 a P0 needs ~34 GiB and a P1 ~42 GiB (measured, see README).
#
#   MAX_EPOCHS=80 SEEDS='42 424' WALLTIME=7-00:00:00 EST_SECONDS_PER_EPOCH=6600 \
#   STAGE=P_v1 PACKS=2 MEM_PER_GPU_GB=24 CELLS=experiments/2026-11_pretrain-v1/configs/P_v1.cells bash slurm/ssl_pack.sh
p1_v1  arm=pretrain encoders=rowcol_concat_v0 chunk_size=512 datamodule.batch_size=12800 optimizer.lr=1e-3 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1 pretrain.schedule=wsd pretrain.warmup_epochs=4 pretrain.decay_frac=0.2 ~callbacks.early_stopping
p0_v1  arm=pretrain encoders=rowcol_concat_v0 chunk_size=512 datamodule.batch_size=12800 optimizer.lr=1e-3 pretrain.schedule=wsd pretrain.warmup_epochs=4 pretrain.decay_frac=0.2 ~callbacks.early_stopping
