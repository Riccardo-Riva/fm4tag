# Label-fraction scan, step 1b: regularisation check at 3% of the labels (after L_lr.cells, before L_scan.cells).
# L_lr (2026-11-05) showed every method overfitting within a few epochs at 558k jets: best val CE at epoch 3-8,
# then val CE rising to 0.9 (SC) and 1.3-2.1 (FT, FR) while training CE falls to 0.1-0.5.  The full-data recipe has
# no regularisation to speak of (weight decay 6e-5, dropout 0 except head MLP 0.02), and the lr moved the best
# val CE by <= 0.01 against method gaps of 0.05-0.06.
#
# Each method at its L_lr winner (SC 1.2e-3, FT 3e-4 with backbone lr / 10, FR 1.2e-3), three settings:
#   wd    AdamW weight decay 0.05 (the usual transformer value; today 6e-5)
#   do    dropout 0.1 in the aggregator's feed-forward layers and the head MLP: the trainable part that all three
#         methods share (FR's encoders are frozen, so encoder dropout would not act on FR).  No attention dropout:
#         it turns off the varlen flash kernel (models/attention.py _use_varlen) and the aggregator would fall
#         back to a Python loop over every jet.
#   wddo  both
# The L_lr winners are the unregularised baseline.  Seed 42 and the P0 seed-42 checkpoint, as in L_lr.
#
#   ENCODERS=rowcol_concat_v0 CHUNK=512 SEEDS=42 PACKS=2 MEM_PER_GPU_GB=22 \
#   MAX_EPOCHS=100 EST_SECONDS_PER_EPOCH=150 WALLTIME=1-00:00:00 \
#   CELLS=scripts/configs/campaign/L_reg.cells bash slurm/ssl_pack.sh
sc_lab3_wd  arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=1.2e-3 optimizer.weight_decay=0.05
sc_lab3_do  arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=1.2e-3 aggregator.ff_dropout=0.1 head.mlp_dropout=0.1
sc_lab3_wddo  arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=1.2e-3 optimizer.weight_decay=0.05 aggregator.ff_dropout=0.1 head.mlp_dropout=0.1
ft_p0_lab3_wd  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=3e-4 optimizer.backbone_lr=3e-5 optimizer.weight_decay=0.05
ft_p0_lab3_do  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=3e-4 optimizer.backbone_lr=3e-5 aggregator.ff_dropout=0.1 head.mlp_dropout=0.1
ft_p0_lab3_wddo  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=3e-4 optimizer.backbone_lr=3e-5 optimizer.weight_decay=0.05 aggregator.ff_dropout=0.1 head.mlp_dropout=0.1
fr_p0_lab3_wd  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=1.2e-3 optimizer.weight_decay=0.05
fr_p0_lab3_do  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=1.2e-3 aggregator.ff_dropout=0.1 head.mlp_dropout=0.1
fr_p0_lab3_wddo  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=8192 datamodule.train_max_rows=558000 trainer.log_every_n_steps=20 optimizer.lr=1.2e-3 optimizer.weight_decay=0.05 aggregator.ff_dropout=0.1 head.mlp_dropout=0.1
