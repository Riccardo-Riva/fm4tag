# S1 — per-feature (per_token) vs SAINT-like (concat) intersample attention,
# from scratch, cross-entropy only, at the two chunk-size candidates (S0).
# Every cell has the same batch and LR — the largest batch both row modes fit in
# ~38 GiB (concat ~33, per_token ~29 GB), lr from the sqrt-B prior (3e-4 @ 2048)
# — so only the architecture and the chunk size differ.
#   CELLS=scripts/configs/campaign/S1_arch.cells SEEDS="42 424" MAX_EPOCHS=100 \
#   EST_SECONDS_PER_EPOCH=2000 GPU_NODE=gpu-A40,gpu-L40S-open MEM=48G bash slurm/ssl_campaign.sh
sc_pt_c128  arm=scratch encoders=rowcol_v0        chunk_size=128 datamodule.batch_size=24576 optimizer.lr=1e-3
sc_pt_c512  arm=scratch encoders=rowcol_v0        chunk_size=512 datamodule.batch_size=24576 optimizer.lr=1e-3
sc_cc_c128  arm=scratch encoders=rowcol_concat_v0 chunk_size=128 datamodule.batch_size=24576 optimizer.lr=1e-3
sc_cc_c512  arm=scratch encoders=rowcol_concat_v0 chunk_size=512 datamodule.batch_size=24576 optimizer.lr=1e-3
