# S2-QK — the S2 recipes again with QK-norm in the row (intersample) attention
# (row_qk_norm, on for every arm in campaign_ssl.yaml since 455cf7d), added
# 2026-10-22. Without it the track row attention's logits grew to 1e5-1e7
# (one-hot attention, entropy ~0) and the 30-epoch pretrainings blew up.
# Checks before the full pretrainings (rriva, 2026-10-22):
#   * qk_p0/1/2: the S2 recipes (T 0.1, lambda 0.4; P1/P2 with JC weight 1.0,
#     JC T 0.1), S2 settings: 10 epochs, B 12288, lr 1e-3, clipping 1.0.
#     Logits bounded (val/row_attn/*), no blowups (train/grad_norm_max)?
#   * fr_qk_*: their probes, against fr_qk_random (the random-encoder floor
#     changes with the architecture). Old S2 probes: P0 0.635, P1 0.632,
#     P2 0.648, random 0.656.
#   * sc_qk: from scratch with S1's sc_cc_c512 settings (100-epoch cosine,
#     early stopping): does its CE stay at S1's 0.620-0.621?
#
#   ENCODERS=rowcol_concat_v0 CHUNK=512 B_PRE=12288 SEEDS=42 PACKS=2 \
#   MEM_PER_GPU_GB=22 MAX_EPOCHS=10 EST_SECONDS_PER_EPOCH=5000 WALLTIME=2-00:00:00 \
#   CELLS=scripts/configs/campaign/S2_qk.cells bash slurm/ssl_pack.sh
qk_p0  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3
qk_p1  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1
qk_p2  arm=pretrain encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=${B_PRE} optimizer.lr=1e-3 pretrain.loss_weights.contrastive=0.0 pretrain.loss_weights.jet_contrastive=1.0 pretrain.jet_contrastive_loss.temperature=0.1
fr_qk_p0  arm=frozen encoder_ckpt=@qk_p0 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
fr_qk_p1  arm=frozen encoder_ckpt=@qk_p1 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
fr_qk_p2  arm=frozen encoder_ckpt=@qk_p2 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
fr_qk_random  arm=frozen require_encoder_ckpt=false encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3 @epochs=15 @est=600
sc_qk  arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=24576 optimizer.lr=1e-3 @epochs=100 @est=1000
