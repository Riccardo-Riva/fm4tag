# Final runs (rriva approved the S3 lrs, 2026-10-28): every arm at its S3 lr, max_epochs 40,
# early stopping as in S3. Downstream seeds are fresh, not S3's 42: the lrs were picked on
# seed 42, so reusing it would bias the winners. Pretrained arms: one cell per pretraining
# seed (42, 424) x 2 downstream seeds; scratch arms: 4 downstream seeds. Longest cells first
# (workers take the queue in order).
#   SC 1.1e-3 · SC+JC 8e-4 · FT<-P0 1.1e-3 (pretrained parts lr/10) · FT+JC<-P1 8e-4 (lr/10)
#   FR<-P0 2e-3 · FR+JC<-P1 1.5e-3
#
#   pretrained arms, 16 tasks:
#   CELL_FILTER='^f[tr]' ENCODERS=rowcol_concat_v0 CHUNK=512 SEEDS='4242 42424' PACKS=5 \
#   MEM_PER_GPU_GB=40 MAX_EPOCHS=40 EST_SECONDS_PER_EPOCH=1250 WALLTIME=2-00:00:00 \
#   CELLS=scripts/configs/campaign/F_final.cells bash slurm/ssl_pack.sh
#   scratch arms, 8 tasks: the same with
#   CELL_FILTER='^sc' SEEDS='4242 42424 424242 4242424' PACKS=3 MEM_PER_GPU_GB=22
ftjc_p1s42  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261026_094445/p1/seed_42 finetune.loss_weights.jet_contrastive=0.3 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=14336 optimizer.lr=8e-4 optimizer.backbone_lr=8e-5 @est=2500
ftjc_p1s424  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261026_094445/p1/seed_424 finetune.loss_weights.jet_contrastive=0.3 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=14336 optimizer.lr=8e-4 optimizer.backbone_lr=8e-5 @est=2500
frjc_p1s42  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261026_094445/p1/seed_42 finetune.loss_weights.jet_contrastive=0.3 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=53760 optimizer.lr=1.5e-3 @est=900
frjc_p1s424  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261026_094445/p1/seed_424 finetune.loss_weights.jet_contrastive=0.3 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=53760 optimizer.lr=1.5e-3 @est=900
ft_p0s42  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=28672 optimizer.lr=1.1e-3 optimizer.backbone_lr=1.1e-4
ft_p0s424  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_424 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=28672 optimizer.lr=1.1e-3 optimizer.backbone_lr=1.1e-4
fr_p0s42  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=94208 optimizer.lr=2e-3 @est=650
fr_p0s424  arm=frozen encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag-chunk/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_424 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=94208 optimizer.lr=2e-3 @est=650
scjc  arm=scratch finetune.loss_weights.jet_contrastive=0.3 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=14336 optimizer.lr=8e-4 @est=2500
sc  arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=28672 optimizer.lr=1.1e-3
