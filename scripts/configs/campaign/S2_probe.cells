# S2 (part 2) — the probe of each S2 pretraining: frozen pretrained encoders,
# aggregator + head trained with cross-entropy, 15 epochs, one fixed lr for all
# (only the ranking matters). PRE = the absolute S2_pretrain stage directory;
# each probe waits for its own pretraining's job automatically.
#
# A P2 probe also starts from P2's pretrained aggregator (load_aggregator: auto);
# a P0 probe trains its aggregator from random init.
# fr_random probes frozen RANDOM encoders: what the probe scores with no
# pretraining at all — the floor every pretraining must beat.
#
#   PRE=/storage3/.../slurm/ssl_campaign/S2_pretrain_<TS> ENCODERS=... CHUNK=... \
#   SEEDS=42 MAX_EPOCHS=15 EST_SECONDS_PER_EPOCH=800 GPU_NODE=gpu-A40,gpu-L40S-open \
#   MEM=48G CELLS=scripts/configs/campaign/S2_probe.cells bash slurm/ssl_campaign.sh
fr_p0_T0.1_lam0.1  arm=frozen encoder_ckpt=@${PRE}/p0_T0.1_lam0.1/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p0_T0.1_lam0.4  arm=frozen encoder_ckpt=@${PRE}/p0_T0.1_lam0.4/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p0_T0.3_lam0.1  arm=frozen encoder_ckpt=@${PRE}/p0_T0.3_lam0.1/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p0_T0.3_lam0.4  arm=frozen encoder_ckpt=@${PRE}/p0_T0.3_lam0.4/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p2_T0.1_lam0.1  arm=frozen encoder_ckpt=@${PRE}/p2_T0.1_lam0.1/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p2_T0.1_lam0.4  arm=frozen encoder_ckpt=@${PRE}/p2_T0.1_lam0.4/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p2_T0.3_lam0.1  arm=frozen encoder_ckpt=@${PRE}/p2_T0.3_lam0.1/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_p2_T0.3_lam0.4  arm=frozen encoder_ckpt=@${PRE}/p2_T0.3_lam0.4/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
fr_random       arm=frozen require_encoder_ckpt=false encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=32768 optimizer.lr=1e-3
