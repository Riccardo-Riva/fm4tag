ft_p0_lr2.2e-3_bb10  arm=finetune encoder_ckpt=@/storage3/DSIP/rriva/research/fm4tag/slurm/ssl_campaign/P_full_20261023_085735/p0/seed_42 encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=28672 optimizer.lr=2.2e-3 optimizer.backbone_lr=2.2e-4
