sc_lr1e-3      arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=24576 optimizer.lr=1e-3
sc_lr2e-3      arm=scratch encoders=${ENCODERS} chunk_size=${CHUNK} datamodule.batch_size=24576 optimizer.lr=2e-3
